# ─── Anthropic API ───────────────────────────────────────
# En desarrollo: usada por el proxy de Vite (NO expuesta al browser)
# En producción (Vercel): agregar como variable de entorno solo de servidor
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Supabase ────────────────────────────────────────────
# Obtenlas en: https://supabase.com → tu proyecto → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — SOLO servidor, NUNCA al browser, NUNCA prefijo VITE_
# Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Lemon Squeezy (pagos) ───────────────────────────────
# Dashboard: https://app.lemonsqueezy.com → Settings → API
LS_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...

# Store ID: LS Dashboard → tu store → ID en la URL
LS_STORE_ID=12345

# Variant IDs: LS Dashboard → Products → tu producto → Variants → ID
# Crear un producto con 3 variantes (Esencial / Premium / Élite)
LS_VARIANT_ESENCIAL=111111
LS_VARIANT_PREMIUM=222222
LS_VARIANT_ELITE=333333

# Webhook Secret: LS Dashboard → Webhooks → tu webhook → Signing secret
LS_WEBHOOK_SECRET=wh-...

# ─── Producción ──────────────────────────────────────────
# URL del deploy (sin slash final). Usada en redirect_url del checkout y CORS.
# Ejemplo: https://kiora.health
PRODUCTION_URL=https://kiora.health

# URL pública del sitio — expuesta al browser (prefijo VITE_).
# Crítico para que los emails de recuperación de contraseña apunten
# al dominio correcto en vez de localhost.
VITE_SITE_URL=https://kiora.health

# ─── Entorno ─────────────────────────────────────────────
VITE_APP_ENV=development
